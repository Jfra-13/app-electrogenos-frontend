---
const features = [
  {
    title: "Catálogo completo",
    description:
      "Todos los grupos electrógenos con precio en tiempo real, listos para cotizar.",
    icon: "clipboard",
  },
  {
    title: "Entrega inmediata",
    description: "Stock disponible para cubrir pedidos urgentes sin demoras.",
    icon: "bolt",
  },
  {
    title: "Certificados",
    description: "Equipos con normas ISO y seguridad industrial garantizadas.",
    icon: "shield",
  },
  {
    title: "Asesoría técnica",
    description: "Ingenieros disponibles para acompañar cada proyecto.",
    icon: "chart",
  },
];

const icons: Record<string, string> = {
  clipboard:
    "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2",
  bolt: "M13 10V3L4 14h7v7l9-11h-7z",
  shield:
    "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  chart:
    "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
};
---

<section id="nosotros" class="py-20 bg-white scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p
        class="text-xs font-semibold uppercase tracking-[0.16em] text-orange-500 mb-3"
      >
        Por qué Electrogen
      </p>
      <h2 class="text-3xl md:text-4xl font-bold text-blue-950">
        Energía confiable de principio a fin
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        features.map((feature) => (
          <div class="bg-gray-50 rounded-3xl p-8 transition-colors hover:bg-orange-50">
            <div class="w-12 h-12 rounded-full bg-orange-100 flex items-center justify-center mb-4">
              <svg
                class="w-6 h-6 text-orange-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d={icons[feature.icon]}
                />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-blue-950 mb-2">{feature.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              {feature.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
