---
import "../styles/global.css";
import Sidebar from "../features/admin/components/Sidebar.astro";
import UserDropdown from "../features/admin/components/UserDropdown";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Intranet Electrogen</title>
    <style>
      .intranet-body {
        padding-left: var(--sidebar-width, 16rem);
        transition: padding-left 200ms ease;
      }

      @media (max-width: 1024px) {
        .intranet-body {
          padding-left: 0;
        }
      }
    </style>
  </head>
  <body class="intranet-body bg-gray-50 text-gray-900 antialiased">
    <Sidebar />
    <header
      class="h-20 bg-white border-b border-gray-200 flex items-center justify-end px-8 sticky top-0 z-10"
    >
      <UserDropdown client:load />
    </header>
    <main class="p-8">
      <slot />
    </main>
  </body>
</html>
