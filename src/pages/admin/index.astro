---
import IntranetLayout from "../../layouts/IntranetLayout.astro";
---

<IntranetLayout title="Panel de Control">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-3xl font-bold text-blue-950 mb-2">Panel de Control</h1>
    <p class="text-gray-600 mb-8">
      Bienvenido a la intranet. Has superado el muro de seguridad
      satisfactoriamente.
    </p>

    <div
      class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-center h-64 border-dashed border-2"
    >
      <!-- Placeholder para próximos MVPs -->
      <span class="text-gray-400 font-medium"
        >Aquí ubicaremos el CRUD de Equipos...</span
      >
    </div>
  </div>
</IntranetLayout>
